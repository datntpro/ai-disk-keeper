    "fda.explain" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS hides a few locations, such as some app containers, unless you allow it. Without it, AI Disk Keeper still works and lists what it couldn't read."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS ẩn một số vị trí, chẳng hạn một số vùng chứa của ứng dụng, trừ khi bạn cho phép. Không có quyền này, AI Disk Keeper vẫn hoạt động và liệt kê những gì không đọc được."
          }
        }
      }
    },
