        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Một lần quét chỉ đọc trên công cụ AI, worktree, mô hình, rác hệ thống, tệp lớn, tệp trùng lặp và ứng dụng. Bạn xem lại mọi thứ trước khi bất cứ thứ gì được chuyển vào Thùng rác."
          }
        }
      }
    },
