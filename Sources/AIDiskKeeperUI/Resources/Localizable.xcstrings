    "tier.keep.label" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Giữ lại"
          }
        }
      }
    },
    "tier.keep.long" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recent, in use, or holding work that isn't saved anywhere else (for example uncommitted changes). AI Disk Keeper will not clean it."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mục gần đây, đang được dùng, hoặc chứa công việc chưa được lưu ở nơi nào khác (ví dụ các thay đổi chưa commit). AI Disk Keeper sẽ không dọn mục này."
          }
        }
      }
    },
    "tier.keep.short" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shown so you know where space goes. Not cleanable."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chỉ hiển thị để bạn biết dung lượng đi đâu. Không thể dọn."
          }
        }
      }
    },
    "tier.review.label" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cần xem"
          }
        }
      }
    },
    "tier.review.long" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Things like old chat or session history you can no longer resume, a model you'd have to download again, or dependencies you'd have to reinstall. Read the explanation, then tick each item yourself. Review items are never selected in bulk."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gồm những thứ như lịch sử hội thoại hoặc phiên cũ mà bạn không thể tiếp tục được nữa, một mô hình bạn sẽ phải tải lại, hoặc các thư viện phụ thuộc bạn sẽ phải cài lại. Hãy đọc phần giải thích rồi tự chọn từng mục. Mục Cần xem không bao giờ được chọn hàng loạt."
          }
        }
      }
    },
    "tier.review.short" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probably safe, but cleaning it costs something. Check it yourself."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Có thể dọn, nhưng bạn sẽ mất một thứ gì đó. Hãy tự kiểm tra trước."
          }
        }
      }
    },
    "tier.safe.label" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safe"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "An toàn"
          }
        }
      }
    },
    "tier.safe.long" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caches, temporary files and old data the tool regenerates on its own. Cleaning it moves it to the Trash and costs you nothing except, sometimes, a slower first launch."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cache, tệp tạm và dữ liệu cũ mà công cụ tự tạo lại. Dọn đi chỉ là chuyển vào Thùng rác và bạn không mất gì, trừ việc đôi khi lần mở đầu tiên chậm hơn."
          }
        }
      }
    },
    "tier.safe.short" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safe to clean. It's rebuilt automatically or holds nothing you need."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dọn thoải mái. Dữ liệu này được tạo lại tự động hoặc không chứa gì bạn cần."
          }
        }
      }
    },
