    "state.firstRun.whatBody" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI tool folders (~/.claude, ~/.cursor…), agent worktrees, model caches, system and developer caches, large and old files, duplicates in Home, and app leftovers in ~/Library. Folder sizes only; file contents are read only to compare duplicates."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Thư mục của công cụ AI (~/.claude, ~/.cursor…), worktree của agent, cache mô hình, cache hệ thống và cache phát triển, tệp lớn và cũ, tệp trùng lặp trong Home, và tệp sót lại của ứng dụng trong ~/Library. Chỉ đọc kích thước thư mục; nội dung tệp chỉ được đọc để so sánh tệp trùng lặp."
          }
        }
      }
